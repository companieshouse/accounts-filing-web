{
    "compilerOptions": {
        "allowJs": true,
        "target": "ES2017",
        "module": "commonjs",
        "esModuleInterop": true,
        "moduleResolution": "node",
        "pretty": true,
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./src",
        "skipLibCheck": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "strictNullChecks": true,
        "strict": true,
        "noImplicitAny": true,
        "typeRoots": [
            "src/types/@types",
            "node_modules/@types"
        ],
        "types": [
            "node",
            "jest",
            "express"
        ]
    },
    "ts-node": {
        "esm": true
    },
    "lib": ["esnext"],
    "include": [
        "./src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "tests",
        "dist"
    ]
}
